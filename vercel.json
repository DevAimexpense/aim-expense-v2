{
  "$schema": "https://openapi.vercel.sh/vercel.json",
  "framework": "nextjs",
  "regions": [
    "sin1"
  ],
  "functions": {
    "src/app/api/line/webhook/route.ts": {
      "maxDuration": 30
    },
    "src/app/api/ocr/receipt/route.ts": {
      "maxDuration": 30
    },
    "src/app/api/payments/upload/route.ts": {
      "maxDuration": 30
    },
    "src/app/api/documents/save-pdf/route.ts": {
      "maxDuration": 30
    },
    "src/app/api/documents/save-sales-pdf/route.ts": {
      "maxDuration": 60
    },
    "src/app/api/documents/wht-cert/[paymentId]/save/route.ts": {
      "maxDuration": 60
    },
    "src/app/api/statements/upload/route.ts": {
      "maxDuration": 60
    }
  },
  "crons": [
    {
      "path": "/api/cron/expire-trials",
      "schedule": "0 1 * * *"
    },
    {
      "path": "/api/cron/expire-manual-plans",
      "schedule": "10 1 * * *"
    },
    {
      "path": "/api/cron/trial-reminders",
      "schedule": "30 1 * * *"
    },
    {
      "path": "/api/cron/cleanup-line-drafts",
      "schedule": "0 20 * * *"
    },
    {
      "path": "/api/cron/period-fingerprint",
      "schedule": "40 1 * * *"
    }
  ]
}
